{
  "name": "credenza-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/dev-server.js",
    "start": "node src/dev-server.js",
